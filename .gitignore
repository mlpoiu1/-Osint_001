# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as long as they are installed
#  from the database they should be ignorable.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tolles/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.mypy_cache/
.pytest_cache/
.hypothesis/
.ruff_cache/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Sphinx documentation
docs/_build/

# PyBuilder
*.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the project is
#   environment-agnostic.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you're building a library, you should ignore it.
# Pipfile.lock

# poetry
#   Similarly, include poetry.lock in version control, but usually exclude it for libraries.
# poetry.lock

# pdm
#   Similar to Poetry and Pipenv, PDM stores project dependencies in pyproject.toml
#   Along with PDM's lockfile pdm.lock, which is a good idea to commit.
# pdm.lock

# virtualenv
.venv/
venv/
ENV/
env/
active_env/

# IDEs
.idea/
.vscode/
*.swp
*.swo
